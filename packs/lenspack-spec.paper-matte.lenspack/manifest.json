{
  "lenspack": 4,
  "id": "@lenspack-spec/paper-matte",
  "version": "1.0.0",
  "name": "Paper Matte",
  "author": "@lenspack-spec",
  "summary": "Lifted blacks, low contrast, fine grain, a touch warm.",
  "license": "CC0-1.0",
  "required": [
    "effects"
  ],
  "effects": [
    {
      "type": "fade",
      "intensity": 0.55
    },
    {
      "type": "contrast",
      "intensity": 0.4
    },
    {
      "type": "temperature",
      "intensity": 0.5,
      "params": {
        "kelvinShift": -350
      }
    },
    {
      "type": "grain",
      "intensity": 0.35,
      "params": {
        "size": 0.0015,
        "roughness": 0.6,
        "chroma": 0.15
      }
    }
  ],
  "thumbnail": "thumb.png"
}
