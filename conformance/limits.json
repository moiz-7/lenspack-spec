{
  "lenspack": 4,
  "revision": 2,
  "id": {
    "pattern": "^@[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,63}$",
    "legacyPrefix": "legacy:",
    "legacyDigestHexChars": 16
  },
  "version": {
    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
  },
  "license": {
    "pattern": "^[A-Za-z0-9.+()-]+( (AND|OR|WITH) [A-Za-z0-9.+()-]+)*$",
    "maxLength": 64
  },
  "localized": {
    "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "fields": ["name", "summary"]
  },
  "paths": {
    "maxComponents": 2
  },
  "archive": {
    "maxArchiveBytes": 26214400,
    "maxEntries": 64,
    "maxEntryBytes": 16777216,
    "maxUncompressedBytes": 67108864,
    "maxCompressionRatio": 100
  },
  "index": {
    "maxIndexBytes": 262144,
    "kinds": ["cube", "pack"]
  },
  "lut": {
    "maxFileBytes": 8388608,
    "minSize": 2,
    "maxSize": 65,
    "inputs": ["srgb-display", "rec709-display", "p3-display", "apple-log", "hlg"],
    "outputs": ["srgb-display", "rec709-display", "p3-display"],
    "defaultInput": "srgb-display"
  },
  "overlays": {
    "max": 8,
    "maxImagePixels": 4000000,
    "maxAnimatedFramePixels": 1000000,
    "maxFrames": 24,
    "anchors": [
      "forehead", "eyes", "nose", "mouth", "chin", "leftEye", "rightEye", "leftCheek",
      "rightCheek", "head", "face"
    ],
    "blends": ["normal", "multiply", "screen", "add", "overlay", "softLight"],
    "faces": ["all", "largest"],
    "maxFaceCount": 8,
    "scale": [0.1, 3],
    "offset": [-1, 1],
    "fps": [1, 30],
    "opacity": [0, 1],
    "z": [-100, 100],
    "blendsRequiring": {"overlay": "overlayBlendExtended", "softLight": "overlayBlendExtended"},
    "poses": ["roll", "full", "screen"],
    "stages": ["top", "scene"],
    "maxVariants": 7
  },
  "triggers": {
    "max": 8,
    "blendshapes": ["mouthOpen", "smile", "browsUp", "blink", "wink", "kiss", "tongueOut", "cheekPuff"],
    "modes": ["while", "toggle", "once"],
    "meshOnly": ["tongueOut", "cheekPuff"]
  },
  "facePaint": {
    "maxFrames": 8,
    "maxFramePixels": 1000000,
    "blends": ["normal", "multiply", "screen", "overlay", "softLight"]
  },
  "retouch": {
    "skinSmoothing": [0, 0.6]
  },
  "background": {
    "modes": ["blur", "image"],
    "amount": [0, 1],
    "fits": ["fill", "fit"]
  },
  "skinProtect": [0, 1],
  "effects": {
    "max": 16,
    "types": [
      "bloom", "halation", "grain", "vignette", "saturation", "contrast", "temperature",
      "fade", "sharpen"
    ],
    "params": {
      "grain": {"size": [0.0002, 0.02], "roughness": [0, 1], "chroma": [0, 1]},
      "bloom": {"radius": [0.001, 0.1], "threshold": [0, 1]},
      "halation": {"radius": [0.001, 0.1], "threshold": [0, 1]},
      "vignette": {"midpoint": [0, 1], "feather": [0, 1]},
      "temperature": {"kelvinShift": [-3000, 3000], "tint": [-1, 1]}
    }
  },
  "data": {
    "max": 4,
    "types": ["elevation", "speed"],
    "positions": ["topLeft", "topRight", "bottomLeft", "bottomRight"]
  },
  "pack": {
    "maxOverlayPixels": 32000000
  },
  "thumbnail": {
    "maxEdge": 512
  },
  "requires": ["depth", "faceTracking"],
  "features": [
    "lut", "lutInput", "effects", "effectParams", "overlays", "overlayOpacity",
    "overlayBlend", "overlayZ", "overlayFaces", "data", "meshTexture", "triggers",
    "overlayPose", "overlayStage", "overlayBehind", "overlayVariants", "faceAnchors",
    "overlayBlendExtended", "triggerModes", "triggerShapes2", "facePaint", "retouch",
    "background", "skinProtect"
  ],
  "remixOf": {
    "idPattern": "^(@[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,63}|legacy:[0-9a-f]{16})$"
  }
}
