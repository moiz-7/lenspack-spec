{
  "lenspack": 4,
  "id": "@lenspack-spec/party-crown",
  "version": "1.0.0",
  "name": "Party Crown",
  "author": "@lenspack-spec",
  "summary": "A crown on every face, with a little bloom and grain.",
  "license": "CC-BY-4.0",
  "required": ["overlays"],
  "requires": ["faceTracking"],
  "effects": [
    {"type": "bloom", "intensity": 0.35},
    {"type": "grain", "intensity": 0.2}
  ],
  "overlays": [
    {"image": "crown.png", "anchor": "forehead", "scale": 1.3, "offsetY": 0.1}
  ]
}
